<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laundrylink.controller.ServicesPricesController">
   <stylesheets>
      <URL value="@../css/laundrylink.css" />
   </stylesheets>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox>
               <children>
                  <Label styleClass="page-title" text="Services &amp; Prices" />
                  <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="250.0" promptText="Search service name..." />
            <Label fx:id="statusFilterLabel" text="Status:" />
            <ComboBox fx:id="statusFilterComboBox" prefWidth="120.0" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
         </children>
      </HBox>
      <TableView fx:id="servicesTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="serviceNameColumn" prefWidth="360.0" text="Service" />
            <TableColumn fx:id="pricingUnitColumn" prefWidth="220.0" text="Pricing Unit" />
            <TableColumn fx:id="priceColumn" prefWidth="220.0" text="Current Price" />
            <TableColumn fx:id="statusColumn" prefWidth="160.0" text="Status" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label fx:id="tablePlaceholderLabel" styleClass="note-text" text="Loading services..." />
         </placeholder>
      </TableView>
   </children>
</VBox>
