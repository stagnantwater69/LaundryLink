<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laundrylink.controller.ServicesPricesController">
   <stylesheets>
      <URL value="@../css/laundrylink.css" />
   </stylesheets>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox>
               <children>
                  <Label styleClass="page-title" text="Services &amp; Prices" />
                  <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="250.0" promptText="Search service name..." />
            <Label fx:id="statusFilterLabel" text="Status:" />
            <ComboBox fx:id="statusFilterComboBox" prefWidth="120.0" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
         </children>
      </HBox>
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="servicesTable" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="serviceNameColumn" prefWidth="300.0" text="Service" />
                  <TableColumn fx:id="pricingUnitColumn" prefWidth="180.0" text="Pricing Unit" />
                  <TableColumn fx:id="priceColumn" prefWidth="180.0" text="Current Price" />
                  <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label fx:id="tablePlaceholderLabel" styleClass="note-text" text="Loading services..." />
               </placeholder>
            </TableView>
            <VBox fx:id="managementPane" minWidth="320.0" prefWidth="350.0" styleClass="card">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="card-header,compact">
                     <children>
                        <Label fx:id="formTitleLabel" styleClass="card-header-title" text="New Service" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleNew" styleClass="compact-button" text="New" />
                     </children>
                  </HBox>
                  <VBox spacing="6.0" styleClass="card-body" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="field-label" text="Service Name" />
                        <TextField fx:id="serviceNameField" promptText="e.g. Wash and Fold" />
                        <Label styleClass="field-label" text="Pricing Unit" />
                        <ComboBox fx:id="pricingUnitComboBox" maxWidth="1.7976931348623157E308" promptText="Select a pricing unit" />
                        <Label styleClass="field-label" text="Current Price" />
                        <TextField fx:id="priceField" promptText="e.g. 65.00" />
                        <Label styleClass="note-text" text="Select a row to inspect it, or click New to prepare a service. Saving will be added in the next step." wrapText="true">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
